<Window x:Class="PIDTuner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:PIDTuner.Desktop.ViewModels"
        Title="PIDTuner"
        Width="1180"
        Height="800"
        MinWidth="960"
        MinHeight="640">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>

  <Window.DataContext>
    <viewModels:MainWindowViewModel />
  </Window.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Padding="16"
            Background="#1F2937">
      <TextBlock Text="{Binding Title}"
                 FontSize="20"
                 Foreground="White"
                 FontWeight="SemiBold" />
    </Border>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="14"
                 Foreground="#374151" />

      <Border Grid.Row="1"
              Margin="0,10,0,0"
              Padding="12"
              BorderBrush="#93C5FD"
              BorderThickness="1"
              Background="#EFF6FF"
              Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right"
                  Command="{Binding DismissNotificationCommand}"
                  Content="关闭"
                  Width="56"
                  Height="28"
                  Margin="12,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding NotificationTitle}"
                       FontWeight="SemiBold"
                       Foreground="#1F2937" />
            <TextBlock Text="{Binding NotificationMessage}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="#374151" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TabControl Grid.Row="2"
                  SelectedIndex="2"
                  Margin="0,16,0,0">
        <TabItem Header="连接与配置" />
        <TabItem Header="实时监控" />
        <TabItem Header="分析">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel>
              <Button Command="{Binding LoadFieldProfileCommand}"
                      Content="导入字段配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding LoadExampleCommand}"
                      Content="载入示例"
                      Width="96"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding SaveFieldProfileCommand}"
                      Content="保存字段配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding ImportCsvCommand}"
                      Content="导入 CSV"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding ExportAnalysisResultCommand}"
                      Content="导出分析结果"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding SaveTestSessionCommand}"
                      Content="保存试验记录"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <TextBlock Text="{Binding CurrentFieldProfile}"
                         VerticalAlignment="Center"
                         Margin="4,0,0,8"
                         Foreground="#374151" />
            </WrapPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
              <TextBlock Text="分析开始"
                         VerticalAlignment="Center"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding AnalysisStartText, UpdateSourceTrigger=PropertyChanged}"
                       Width="260"
                       Height="28"
                       Margin="8,0,20,0" />
              <TextBlock Text="分析结束"
                         VerticalAlignment="Center"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding AnalysisEndText, UpdateSourceTrigger=PropertyChanged}"
                       Width="260"
                       Height="28"
                       Margin="8,0,0,0" />
              <TextBlock Text="本次窗口"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"
                         Foreground="#6B7280" />
              <TextBlock Text="{Binding ActiveAnalysisWindow}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         Foreground="#374151" />
            </StackPanel>

            <UniformGrid Grid.Row="2"
                         Columns="5"
                         Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="样本数"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SampleCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="超调量"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding OvershootPercent}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="上升时间"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding RiseTime}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="调节时间"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SettlingTime}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="稳态误差"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SteadyStateError}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="{Binding AssessmentSummary}"
                       Margin="0,12,0,0"
                       Foreground="#374151"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="4"
                  Margin="0,16,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,20,0">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#2563EB"
                             VerticalAlignment="Center" />
                  <TextBlock Text="SP"
                             Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,20,0">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#059669"
                             VerticalAlignment="Center" />
                  <TextBlock Text="PV"
                             Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#DC2626"
                             VerticalAlignment="Center" />
                  <TextBlock Text="MV"
                             Margin="6,0,0,0" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Row="1"
                      Width="560"
                      Height="200"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      Background="#F9FAFB">
                <Canvas Width="520"
                        Height="160"
                        Margin="20">
                  <Line X1="0"
                        Y1="80"
                        X2="520"
                        Y2="80"
                        Stroke="#E5E7EB" />
                  <Line X1="0"
                        Y1="40"
                        X2="520"
                        Y2="40"
                        Stroke="#E5E7EB" />
                  <Line X1="0"
                        Y1="120"
                        X2="520"
                        Y2="120"
                        Stroke="#E5E7EB" />
                  <Polyline Points="{Binding SetPointPoints}"
                            Stroke="#2563EB"
                            StrokeThickness="2" />
                  <Polyline Points="{Binding ProcessValuePoints}"
                            Stroke="#059669"
                            StrokeThickness="2" />
                  <Polyline Points="{Binding ManipulatedValuePoints}"
                            Stroke="#DC2626"
                            StrokeThickness="2" />
                </Canvas>
              </Border>

              <Grid Grid.Row="2"
                    Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="760" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DataGrid ItemsSource="{Binding FieldDefinitions}"
                          SelectedItem="{Binding SelectedFieldDefinition}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Height="150"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="字段"
                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        Width="78" />
                    <DataGridTextColumn Header="显示名"
                                        Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="78" />
                    <DataGridTemplateColumn Header="类型"
                                            Width="96">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DataType}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding DataContext.AvailableFieldDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="必填"
                                            Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
                                            Width="44" />
                    <DataGridTextColumn Header="单位"
                                        Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                        Width="44" />
                    <DataGridTemplateColumn Header="角色"
                                            Width="126">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Role}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding DataContext.AvailableFieldRoles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top">
                  <Button Command="{Binding AddFieldCommand}"
                          Content="新增字段"
                          Width="96"
                          Height="32" />
                  <Button Command="{Binding RemoveFieldCommand}"
                          Content="删除字段"
                          Width="96"
                          Height="32"
                          Margin="10,0,0,0" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="参数调整" />
        <TabItem Header="历史记录">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding LoadHistoryCommand}"
                      Content="刷新历史"
                      Width="96"
                      Height="36" />
              <Button Command="{Binding OpenHistorySessionCommand}"
                      Content="打开记录"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <Button Command="{Binding ExportHistorySamplesCommand}"
                      Content="导出采样"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <TextBlock Text="筛选"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                       Width="180"
                       Height="28"
                       Margin="8,0,0,0" />
              <TextBlock Text="{Binding HistoryStatus}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         Foreground="#374151" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
              </Grid.ColumnDefinitions>

              <DataGrid ItemsSource="{Binding HistorySessions}"
                        SelectedItem="{Binding SelectedHistorySession}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名称"
                                      Binding="{Binding Name}"
                                      Width="170" />
                  <DataGridTextColumn Header="开始"
                                      Binding="{Binding StartedAt}"
                                      Width="145" />
                  <DataGridTextColumn Header="结束"
                                      Binding="{Binding EndedAt}"
                                      Width="145" />
                  <DataGridTextColumn Header="持续"
                                      Binding="{Binding Duration}"
                                      Width="80" />
                  <DataGridTextColumn Header="样本"
                                      Binding="{Binding SampleCount}"
                                      Width="60" />
                  <DataGridTextColumn Header="设备"
                                      Binding="{Binding Device}"
                                      Width="110" />
                  <DataGridTextColumn Header="工况"
                                      Binding="{Binding OperatingCondition}"
                                      Width="130" />
                  <DataGridTextColumn Header="备注"
                                      Binding="{Binding Notes}"
                                      Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <Border Grid.Column="1"
                      Margin="16,0,0,0"
                      Padding="12"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      Background="#F9FAFB">
                <StackPanel>
                  <TextBlock Text="记录详情"
                             FontWeight="SemiBold"
                             Foreground="#1F2937" />
                  <TextBlock Text="{Binding SelectedHistoryDetails}"
                             Margin="0,10,0,0"
                             TextWrapping="Wrap"
                             Foreground="#374151" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="系统日志" />
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
