<Window x:Class="PIDTuner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:viewModels="clr-namespace:PIDTuner.Desktop.ViewModels"
        Title="PIDTuner"
        Width="1180"
        Height="800"
        MinWidth="960"
        MinHeight="640">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="FontSize"
              Value="15" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Padding"
              Value="12,6" />
    </Style>
    <Style TargetType="{x:Type Button}">
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Padding"
              Value="8,4" />
    </Style>
    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="RowHeight"
              Value="28" />
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="FontSize"
              Value="13" />
      <Setter Property="FontWeight"
              Value="SemiBold" />
      <Setter Property="Padding"
              Value="8,6" />
    </Style>
  </Window.Resources>

  <Window.DataContext>
    <viewModels:MainWindowViewModel />
  </Window.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Padding="16"
            Background="#1F2937">
      <TextBlock Text="{Binding Title}"
                 FontSize="20"
                 Foreground="White"
                 FontWeight="SemiBold" />
    </Border>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Foreground="#374151" />

      <Border Grid.Row="1"
              Margin="0,10,0,0"
              Padding="12"
              BorderBrush="#93C5FD"
              BorderThickness="1"
              Background="#EFF6FF"
              Visibility="Collapsed">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right"
                  Command="{Binding DismissNotificationCommand}"
                  Content="关闭"
                  Width="56"
                  Height="28"
                  Margin="12,0,0,0" />
          <StackPanel>
            <TextBlock Text="{Binding NotificationTitle}"
                       FontWeight="SemiBold"
                       Foreground="#1F2937" />
            <TextBlock Text="{Binding NotificationMessage}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="#374151" />
          </StackPanel>
        </DockPanel>
      </Border>

      <TabControl Grid.Row="2"
                  SelectedIndex="2"
                  Margin="0,16,0,0">
        <TabItem Header="连接与配置">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel>
              <Button Command="{Binding LoadPlcConfigurationCommand}"
                      Content="导入 PLC 配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding SavePlcConfigurationCommand}"
                      Content="保存 PLC 配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding AddTagCommand}"
                      Content="新增点位"
                      Width="96"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding RemoveTagCommand}"
                      Content="删除点位"
                      Width="96"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding CheckPlcCommunicationCommand}"
                      Content="检查通信"
                      Width="96"
                      Height="36"
                      Margin="0,0,12,8" />
              <TextBlock Text="{Binding PlcConfigurationStatus}"
                         VerticalAlignment="Center"
                         Margin="4,0,0,8"
                         Foreground="#374151" />
              <TextBlock Text="{Binding PlcCommunicationStatus}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,8"
                         Foreground="#374151" />
            </WrapPanel>

            <Grid Grid.Row="1"
                  Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="90" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Text="配置名"
                         Foreground="#6B7280" />
              <TextBox Grid.Row="1"
                       Text="{Binding PlcConfigurationName, UpdateSourceTrigger=PropertyChanged}"
                       Height="28" />
              <TextBlock Grid.Column="1"
                         Text="协议"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding PlcProtocol, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="2"
                         Text="IP"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="4"
                         Text="Rack"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="4"
                       Text="{Binding PlcRack, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="5"
                         Text="Slot"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="5"
                       Text="{Binding PlcSlot, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="6"
                         Text="超时 ms"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="6"
                       Text="{Binding PlcTimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="7"
                         Text="默认采样 ms"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="7"
                       Text="{Binding PlcDefaultSamplingMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
              <TextBlock Grid.Column="8"
                         Text="最小采样 ms"
                         Foreground="#6B7280"
                         Margin="12,0,0,0" />
              <TextBox Grid.Row="1"
                       Grid.Column="8"
                       Text="{Binding PlcMinimumSamplingMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                       Height="28"
                       Margin="12,0,0,0" />
            </Grid>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding TagDefinitions}"
                      SelectedItem="{Binding SelectedTagDefinition}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      Margin="0,18,0,0"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用"
                                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                        Width="48" />
                <DataGridTextColumn Header="名称"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90" />
                <DataGridTextColumn Header="地址"
                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130" />
                <DataGridTemplateColumn Header="类型"
                                        Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DataType}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding DataContext.AvailablePlcDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="权限"
                                        Width="96">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding AccessMode}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                  <DataGridTemplateColumn.CellEditingTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding DataContext.AvailableTagAccessModes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding AccessMode, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="缩放"
                                    Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                    Width="70" />
                <DataGridTextColumn Header="单位"
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="70" />
                <DataGridTextColumn Header="点位采样 ms"
                                    Binding="{Binding SamplingMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80" />
                <DataGridTextColumn Header="描述"
                                    Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="实时监控">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="3*" />
              <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <StackPanel>
              <WrapPanel>
                <Button Command="{Binding CheckPlcCommunicationCommand}"
                        Content="检查通信"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding RefreshPlcMonitorCommand}"
                        Content="刷新点位"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding ShowPlcLiveTrendCommand}"
                        Content="实时趋势"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding ShowPlcHistoricalTrendCommand}"
                        Content="历史趋势"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding TogglePlcMonitoringCommand}"
                        Content="启动/停止"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding RecordPlcOneSecondCommand}"
                        Content="记录 1s"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding LoadPlcRecordingCommand}"
                        Content="打开记录"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding TogglePlcReplayCommand}"
                        Content="播放/暂停"
                        Width="96"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding StepPlcReplayBackwardCommand}"
                        Content="上一帧"
                        Width="76"
                        Height="36"
                        Margin="0,0,12,8" />
                <Button Command="{Binding StepPlcReplayForwardCommand}"
                        Content="下一帧"
                        Width="76"
                        Height="36"
                        Margin="0,0,12,8" />
                <TextBlock Text="{Binding PlcMonitorStatus}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,8"
                           Foreground="#374151" />
                <TextBlock Text="{Binding PlcTrendModeStatus}"
                           VerticalAlignment="Center"
                           Margin="18,0,0,8"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock Text="{Binding PlcCommunicationStatus}"
                           VerticalAlignment="Center"
                           Margin="18,0,0,8"
                           Foreground="#374151" />
              </WrapPanel>
              <TextBlock Text="{Binding PlcAcquisitionDiagnosticsStatus}"
                         Margin="0,0,0,6"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="#0F766E"
                         TextWrapping="Wrap" />
            </StackPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding PlcMonitorTags}"
                      SelectedItem="{Binding SelectedPlcMonitorTag}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      Margin="0,12,0,0"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="趋势"
                                        Binding="{Binding IsTrendVisible, UpdateSourceTrigger=PropertyChanged}"
                                        Width="52" />
                <DataGridTextColumn Header="名称"
                                    Binding="{Binding Name}"
                                    IsReadOnly="True"
                                    Width="100" />
                <DataGridTextColumn Header="地址"
                                    Binding="{Binding Address}"
                                    IsReadOnly="True"
                                    Width="150" />
                <DataGridTextColumn Header="当前值"
                                    Binding="{Binding ValueText}"
                                    IsReadOnly="True"
                                    Width="100" />
                <DataGridTextColumn Header="单位"
                                    Binding="{Binding Unit}"
                                    IsReadOnly="True"
                                    Width="80" />
                <DataGridTextColumn Header="质量"
                                    Binding="{Binding Quality}"
                                    IsReadOnly="True"
                                    Width="100" />
                <DataGridTextColumn Header="来源"
                                    Binding="{Binding Source}"
                                    IsReadOnly="True"
                                    Width="100" />
                <DataGridTextColumn Header="时间"
                                    Binding="{Binding TimestampText}"
                                    IsReadOnly="True"
                                    Width="120" />
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Margin="0,16,0,0"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Background="#F8FAFC">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                  <WrapPanel>
                    <Button Content="10s"
                            Width="48"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="PlcTrendWindow10Seconds_Click" />
                    <Button Content="30s"
                            Width="48"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="PlcTrendWindow30Seconds_Click" />
                    <Button Content="1min"
                            Width="56"
                            Height="28"
                            Margin="0,0,8,0"
                            Click="PlcTrendWindow1Minute_Click" />
                    <Button Content="5min"
                            Width="56"
                            Height="28"
                            Margin="0,0,16,0"
                            Click="PlcTrendWindow5Minutes_Click" />
                    <Button Command="{Binding TogglePlcLiveTrendPauseCommand}"
                            Content="{Binding PlcLiveTrendPauseButtonText}"
                            Width="80"
                            Height="28"
                            Margin="0,0,16,0" />
                    <TextBlock Text="诊断 min ≤30"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="#374151" />
                    <TextBox Text="{Binding PlcDiagnosticsDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="44"
                             Height="28"
                             Margin="0,0,6,0" />
                    <Button Command="{Binding TogglePlcLiveDiagnosticsCommand}"
                            Content="{Binding PlcLiveDiagnosticsButtonText}"
                            Width="76"
                            Height="28"
                            Margin="0,0,16,0" />
                    <Button Command="{Binding ResetPlcHistoricalRangeCommand}"
                            Content="全量历史"
                            Width="76"
                            Height="28"
                            Margin="0,0,16,0" />
                    <Button Command="{Binding ResetPlcTrendYRangeCommand}"
                            Content="自动Y"
                            Width="60"
                            Height="28"
                            Margin="0,0,16,0" />
                    <Button Content="导出可见"
                            Width="72"
                            Height="28"
                            Margin="0,0,16,0"
                            Click="PlcTrendExportVisible_Click" />
                    <Button Command="{Binding SetPlcReplaySpeedHalfCommand}"
                            Content="0.5x"
                            Width="48"
                            Height="28"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding SetPlcReplaySpeedNormalCommand}"
                            Content="1x"
                            Width="48"
                            Height="28"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding SetPlcReplaySpeedDoubleCommand}"
                            Content="2x"
                            Width="48"
                            Height="28"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding SetPlcReplaySpeedFiveCommand}"
                            Content="5x"
                            Width="48"
                            Height="28"
                            Margin="0,0,16,0" />
                    <TextBlock Text="{Binding PlcReplayStatus}"
                               VerticalAlignment="Center"
                               Foreground="#374151" />
                    <TextBlock Text="{Binding PlcLiveDiagnosticsStatus}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Foreground="#374151" />
                  </WrapPanel>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="X窗口"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBlock Text="{Binding PlcHistoricalViewportStartLabel}"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#374151" />
                    <Slider Value="{Binding PlcHistoricalViewportStart, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding PlcHistoricalViewportMinimum}"
                            Maximum="{Binding PlcHistoricalViewportMaximum}"
                            IsEnabled="{Binding IsPlcHistoricalViewportEnabled}"
                            Grid.Column="2"
                            Margin="8,0" />
                    <Slider Value="{Binding PlcHistoricalViewportEnd, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding PlcHistoricalViewportMinimum}"
                            Maximum="{Binding PlcHistoricalViewportMaximum}"
                            IsEnabled="{Binding IsPlcHistoricalViewportEnabled}"
                            Grid.Column="3"
                            Margin="8,0" />
                    <TextBlock Text="{Binding PlcHistoricalViewportEndLabel}"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#374151" />
                  </Grid>
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Y范围"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBlock Text="{Binding PlcTrendYMinText}"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="#374151" />
                    <Slider Value="{Binding PlcTrendYLower, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding PlcTrendYSliderMinimum}"
                            Maximum="{Binding PlcTrendYSliderMaximum}"
                            IsEnabled="{Binding IsPlcTrendYSliderEnabled}"
                            Grid.Column="2"
                            Margin="8,0" />
                    <Slider Value="{Binding PlcTrendYUpper, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding PlcTrendYSliderMinimum}"
                            Maximum="{Binding PlcTrendYSliderMaximum}"
                            IsEnabled="{Binding IsPlcTrendYSliderEnabled}"
                            Grid.Column="3"
                            Margin="8,0" />
                    <TextBlock Text="{Binding PlcTrendYMaxText}"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#374151" />
                  </Grid>
                  <TextBlock x:Name="PlcTrendStatusTextBlock"
                             Margin="0,6,0,0"
                             VerticalAlignment="Center"
                             Foreground="#374151" />
                </StackPanel>

                <scottPlot:WpfPlot x:Name="PlcTrendPlot"
                                   Grid.Row="1"
                                   Margin="0,10,0,0"
                                   MouseMove="PlcTrendPlot_MouseMove"
                                   MouseLeave="PlcTrendPlot_MouseLeave" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>
        <TabItem Header="分析">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel>
              <Button Command="{Binding LoadFieldProfileCommand}"
                      Content="导入字段配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding LoadExampleCommand}"
                      Content="载入示例"
                      Width="96"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding SaveFieldProfileCommand}"
                      Content="保存字段配置"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding ImportCsvCommand}"
                      Content="导入 CSV"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding ExportAnalysisResultCommand}"
                      Content="导出分析结果"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <Button Command="{Binding SaveTestSessionCommand}"
                      Content="保存试验记录"
                      Width="120"
                      Height="36"
                      Margin="0,0,12,8" />
              <TextBlock Text="{Binding CurrentFieldProfile}"
                         VerticalAlignment="Center"
                         Margin="4,0,0,8"
                         Foreground="#374151" />
            </WrapPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,8,0,0">
              <TextBlock Text="分析开始"
                         VerticalAlignment="Center"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding AnalysisStartText, UpdateSourceTrigger=PropertyChanged}"
                       Width="260"
                       Height="28"
                       Margin="8,0,20,0" />
              <TextBlock Text="分析结束"
                         VerticalAlignment="Center"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding AnalysisEndText, UpdateSourceTrigger=PropertyChanged}"
                       Width="260"
                       Height="28"
                       Margin="8,0,0,0" />
              <TextBlock Text="本次窗口"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"
                         Foreground="#6B7280" />
              <TextBlock Text="{Binding ActiveAnalysisWindow}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         Foreground="#374151" />
            </StackPanel>

            <UniformGrid Grid.Row="2"
                         Columns="5"
                         Rows="2"
                         Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="样本数"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SampleCount}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="超调量"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding OvershootPercent}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="上升时间"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding RiseTime}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="调节时间"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SettlingTime}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="稳态误差"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding SteadyStateError}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="峰值"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding PeakProcessValue}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="峰值时间"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding PeakTime}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="平均绝对误差"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding MeanAbsoluteError}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="误差积分"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding IntegralAbsoluteError}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="状态标记"
                           Foreground="#6B7280" />
                <TextBlock Text="{Binding ResponseFlags}"
                           FontSize="18"
                           FontWeight="SemiBold" />
              </StackPanel>
            </UniformGrid>

            <TextBlock Grid.Row="3"
                       Text="{Binding AssessmentSummary}"
                       Margin="0,12,0,0"
                       Foreground="#374151"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="4"
                  Margin="0,16,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,20,0">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#2563EB"
                             VerticalAlignment="Center" />
                  <TextBlock Text="SP"
                             Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,20,0">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#059669"
                             VerticalAlignment="Center" />
                  <TextBlock Text="PV"
                             Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Rectangle Width="22"
                             Height="3"
                             Fill="#DC2626"
                             VerticalAlignment="Center" />
                  <TextBlock Text="MV"
                             Margin="6,0,0,0" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Row="1"
                      Width="560"
                      Height="200"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      Background="#F9FAFB">
                <Canvas Width="520"
                        Height="160"
                        Margin="20">
                  <Line X1="0"
                        Y1="80"
                        X2="520"
                        Y2="80"
                        Stroke="#E5E7EB" />
                  <Line X1="0"
                        Y1="40"
                        X2="520"
                        Y2="40"
                        Stroke="#E5E7EB" />
                  <Line X1="0"
                        Y1="120"
                        X2="520"
                        Y2="120"
                        Stroke="#E5E7EB" />
                  <Polyline Points="{Binding SetPointPoints}"
                            Stroke="#2563EB"
                            StrokeThickness="2" />
                  <Polyline Points="{Binding ProcessValuePoints}"
                            Stroke="#059669"
                            StrokeThickness="2" />
                  <Polyline Points="{Binding ManipulatedValuePoints}"
                            Stroke="#DC2626"
                            StrokeThickness="2" />
                </Canvas>
              </Border>

              <Grid Grid.Row="2"
                    Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="760" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DataGrid ItemsSource="{Binding FieldDefinitions}"
                          SelectedItem="{Binding SelectedFieldDefinition}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          Height="150"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="字段"
                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        Width="78" />
                    <DataGridTextColumn Header="显示名"
                                        Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="78" />
                    <DataGridTemplateColumn Header="类型"
                                            Width="96">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DataType}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding DataContext.AvailableFieldDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="必填"
                                            Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}"
                                            Width="44" />
                    <DataGridTextColumn Header="单位"
                                        Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                        Width="44" />
                    <DataGridTemplateColumn Header="角色"
                                            Width="126">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Role}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                      <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                          <ComboBox ItemsSource="{Binding DataContext.AvailableFieldRoles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    SelectedItem="{Binding Role, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Top">
                  <Button Command="{Binding AddFieldCommand}"
                          Content="新增字段"
                          Width="96"
                          Height="32" />
                  <Button Command="{Binding RemoveFieldCommand}"
                          Content="删除字段"
                          Width="96"
                          Height="32"
                          Margin="10,0,0,0" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="参数调整">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="2*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding RecommendationSummary}"
                       Foreground="#374151"
                       TextWrapping="Wrap" />

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding TuningRecommendations}"
                      SelectedItem="{Binding SelectedTuningRecommendation}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0,16,0,0"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="参数"
                                    Binding="{Binding Parameter}"
                                    Width="70" />
                <DataGridTextColumn Header="方向"
                                    Binding="{Binding Direction}"
                                    Width="90" />
                <DataGridTextColumn Header="建议"
                                    Binding="{Binding Adjustment}"
                                    Width="160" />
                <DataGridTextColumn Header="原因"
                                    Binding="{Binding Reason}"
                                    Width="220" />
                <DataGridTextColumn Header="预期影响"
                                    Binding="{Binding ExpectedEffect}"
                                    Width="220" />
                <DataGridTextColumn Header="风险"
                                    Binding="{Binding Risk}"
                                    Width="240" />
                <DataGridTextColumn Header="置信度"
                                    Binding="{Binding Confidence}"
                                    Width="70" />
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,12,0,0">
              <TextBlock Text="工程师备注"
                         VerticalAlignment="Center"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding RecommendationReviewNote, UpdateSourceTrigger=PropertyChanged}"
                       Width="360"
                       Height="28"
                       Margin="8,0,12,0" />
              <Button Command="{Binding AcceptRecommendationCommand}"
                      Content="记录采用"
                      Width="96"
                      Height="32" />
              <Button Command="{Binding DeferRecommendationCommand}"
                      Content="记录暂缓"
                      Width="96"
                      Height="32"
                      Margin="10,0,0,0" />
              <Button Command="{Binding LoadRecommendationReviewsCommand}"
                      Content="刷新记录"
                      Width="96"
                      Height="32"
                      Margin="10,0,0,0" />
              <Button Command="{Binding SaveParameterSetCommand}"
                      Content="保存参数方案"
                      Width="112"
                      Height="32"
                      Margin="10,0,0,0" />
              <Button Command="{Binding LoadParameterSetsCommand}"
                      Content="刷新方案"
                      Width="96"
                      Height="32"
                      Margin="10,0,0,0" />
              <TextBlock Text="{Binding RecommendationReviewStatus}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         Foreground="#374151" />
            </StackPanel>

            <Grid Grid.Row="3"
                  Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <DataGrid ItemsSource="{Binding RecommendationReviews}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="时间"
                                    Binding="{Binding CreatedAt}"
                                    Width="150" />
                <DataGridTextColumn Header="来源"
                                    Binding="{Binding SourceName}"
                                    Width="160" />
                <DataGridTextColumn Header="参数"
                                    Binding="{Binding Parameter}"
                                    Width="70" />
                <DataGridTextColumn Header="方向"
                                    Binding="{Binding Direction}"
                                    Width="90" />
                <DataGridTextColumn Header="建议"
                                    Binding="{Binding Adjustment}"
                                    Width="160" />
                <DataGridTextColumn Header="处理"
                                    Binding="{Binding Decision}"
                                    Width="90" />
                <DataGridTextColumn Header="备注"
                                    Binding="{Binding EngineerNote}"
                                    Width="*" />
              </DataGrid.Columns>
            </DataGrid>

              <StackPanel Grid.Column="1"
                          Margin="16,0,0,0">
                <TextBlock Text="{Binding ParameterSetStatus}"
                           Foreground="#374151"
                           TextWrapping="Wrap" />
                <DataGrid ItemsSource="{Binding ParameterSets}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="0,8,0,0"
                          CanUserAddRows="False"
                          HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="时间"
                                        Binding="{Binding CapturedAt}"
                                        Width="125" />
                    <DataGridTextColumn Header="Kp"
                                        Binding="{Binding Kp}"
                                        Width="55" />
                    <DataGridTextColumn Header="Ki/Ti"
                                        Binding="{Binding KiOrTi}"
                                        Width="55" />
                    <DataGridTextColumn Header="Kd/Td"
                                        Binding="{Binding KdOrTd}"
                                        Width="55" />
                    <DataGridTextColumn Header="来源"
                                        Binding="{Binding SourceName}"
                                        Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="历史记录">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button Command="{Binding LoadHistoryCommand}"
                      Content="刷新历史"
                      Width="96"
                      Height="36" />
              <Button Command="{Binding OpenHistorySessionCommand}"
                      Content="打开记录"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <Button Command="{Binding ExportHistorySamplesCommand}"
                      Content="导出采样"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <Button Command="{Binding SetHistoryBaselineCommand}"
                      Content="设为基准"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <Button Command="{Binding CompareHistorySessionCommand}"
                      Content="对比选中"
                      Width="96"
                      Height="36"
                      Margin="12,0,0,0" />
              <TextBlock Text="筛选"
                         VerticalAlignment="Center"
                         Margin="20,0,0,0"
                         Foreground="#6B7280" />
              <TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                       Width="180"
                       Height="28"
                       Margin="8,0,0,0" />
              <TextBlock Text="{Binding HistoryStatus}"
                         VerticalAlignment="Center"
                         Margin="16,0,0,0"
                         Foreground="#374151" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
              </Grid.ColumnDefinitions>

              <DataGrid ItemsSource="{Binding HistorySessions}"
                        SelectedItem="{Binding SelectedHistorySession}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="名称"
                                      Binding="{Binding Name}"
                                      Width="170" />
                  <DataGridTextColumn Header="开始"
                                      Binding="{Binding StartedAt}"
                                      Width="145" />
                  <DataGridTextColumn Header="结束"
                                      Binding="{Binding EndedAt}"
                                      Width="145" />
                  <DataGridTextColumn Header="持续"
                                      Binding="{Binding Duration}"
                                      Width="80" />
                  <DataGridTextColumn Header="样本"
                                      Binding="{Binding SampleCount}"
                                      Width="60" />
                  <DataGridTextColumn Header="设备"
                                      Binding="{Binding Device}"
                                      Width="110" />
                  <DataGridTextColumn Header="工况"
                                      Binding="{Binding OperatingCondition}"
                                      Width="130" />
                  <DataGridTextColumn Header="备注"
                                      Binding="{Binding Notes}"
                                      Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <Border Grid.Column="1"
                      Margin="16,0,0,0"
                      Padding="12"
                      BorderBrush="#D1D5DB"
                      BorderThickness="1"
                      Background="#F9FAFB">
                <StackPanel>
                  <TextBlock Text="记录详情"
                             FontWeight="SemiBold"
                             Foreground="#1F2937" />
                  <TextBlock Text="{Binding SelectedHistoryDetails}"
                             Margin="0,10,0,0"
                             TextWrapping="Wrap"
                             Foreground="#374151" />
                  <TextBlock Text="对比结果"
                             Margin="0,18,0,0"
                             FontWeight="SemiBold"
                             Foreground="#1F2937" />
                  <TextBlock Text="{Binding HistoryComparisonStatus}"
                             Margin="0,8,0,0"
                             TextWrapping="Wrap"
                             Foreground="#374151" />
                  <DataGrid ItemsSource="{Binding HistoryComparisonMetrics}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            Margin="0,10,0,0"
                            Height="260">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="指标"
                                          Binding="{Binding Metric}"
                                          Width="110" />
                      <DataGridTextColumn Header="基准"
                                          Binding="{Binding Baseline}"
                                          Width="70" />
                      <DataGridTextColumn Header="对比"
                                          Binding="{Binding Candidate}"
                                          Width="70" />
                      <DataGridTextColumn Header="差值"
                                          Binding="{Binding Delta}"
                                          Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="系统日志" />
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
